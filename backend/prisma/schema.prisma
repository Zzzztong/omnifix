generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  wechat       String?
  address      String?
  notes        String?
  password     String
  role         Role     @default(CUSTOMER)
  referralCode String   @unique
  credits      Float    @default(0)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Category {
  id        String    @id
  name      String
  icon      String
  color     String
  desc      String
  group     String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id         String   @id
  name       String
  price      Float
  duration   String
  desc       String
  popular    Boolean  @default(false)
  active     Boolean  @default(true)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  orders     Order[]
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String
  specialties String[]
  area        String
  rating      Float    @default(5.0)
  jobCount    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  serviceId     String
  techId        String?
  status        OrderStatus @default(PENDING)
  date          String
  time          String
  address       String
  notes         String?
  price         Float
  discount      Float       @default(0)
  tax           Float
  total         Float
  couponCode    String?
  paymentMethod String?
  source        String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])
  technician    Technician? @relation(fields: [techId], references: [id])
  review        Review?
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType @default(GENERAL)
  discountType String
  value        Float
  usageLimit   Int?
  usageCount   Int        @default(0)
  minAmount    Float      @default(0)
  expiresAt    DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CouponType {
  NEW_USER
  GENERAL
  REFERRAL
  SEASONAL
}
